{
  "manifest_version": 3,
  "name": "Stil — Quiet Browsing",
  "short_name": "Stil",
  "version": "0.3.2",
  "description": "Block common advertising networks and hide cookie banners. Simple controls, quieter browsing, all on your device.",
  "browser_specific_settings": {
    "safari": { "strict_min_version": "18.6" }
  },
  "permissions": ["storage", "activeTab", "declarativeNetRequest", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stil — Quiet Browsing",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["selectors.js", "youtube.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ads",
      "enabled": true,
      "path": "rules/ads.json"
    }, {
      "id": "youtube",
      "enabled": true,
      "path": "vendor/youtube/youtube-network.json"
    }]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
